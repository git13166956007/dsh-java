DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY_HOST=127.0.0.1
DEEPSEEK_PROXY_PORT=7897
DSH_PERSISTENCE_ENABLED=true
DSH_DB_URL=jdbc:mariadb://127.0.0.1:3307/dsh
DSH_DB_USER=dsh
DSH_DB_PASSWORD=dsh-local-password
# Set this outside the repository to encrypt persisted model API keys.
DSH_SECRET_KEY=
DSH_WORKSPACE_TOOLS_ENABLED=false
DSH_WORKSPACE_DIR=.
DSH_WORKSPACE_MAX_READ_BYTES=1000000
DSH_WORKSPACE_MAX_WRITE_BYTES=1000000
DSH_WORKSPACE_WRITE_ENABLED=false
DSH_WORKSPACE_PROCESS_ENABLED=false
DSH_WORKSPACE_PROCESS_COMMANDS=
DSH_WORKSPACE_PROCESS_MAX_TIMEOUT_SECONDS=120
DSH_WORKSPACE_PROCESS_MAX_OUTPUT_BYTES=1000000
